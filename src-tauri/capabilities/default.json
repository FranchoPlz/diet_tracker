{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "diet_parser",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:default",
    "fs:default"
  ]
}
